# Copy to .env (gitignored) and fill in. The cloud backend reads env vars with
# the CC_CLOUD_ prefix (see cc_cloud/config.py); pydantic-settings also loads
# this file automatically when running from backend/.

# Shared secret for verifying GitHub webhook signatures (HMAC-SHA256). Generate
# with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Configure the same value on the repo's webhook (Settings -> Webhooks).
CC_CLOUD_WEBHOOK_SECRET=

# Production only: PostgreSQL instead of the default SQLite (backend/cc_cloud.db).
# CC_CLOUD_DATABASE_URL=postgresql+psycopg://user:pass@host/dbname

# Where the worker keeps bare mirror clones (default backend/data/repos, gitignored).
# CC_CLOUD_REPOS_DIR=data/repos
